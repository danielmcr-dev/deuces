# Copy to .env to use real data from Live Tennis API (free plan: https://livetennisapi.com).
# Leave VITE_DATA_SOURCE unset (or "mock") to use the bundled sample data.
VITE_DATA_SOURCE=live
VITE_LIVETENNIS_API_KEY=twjp_your_key_here

# Optional
# VITE_LIVETENNIS_API_BASE_URL=https://api.livetennisapi.com/api/public/v1
# Stop making new API calls after this many per day (free plan limit is 100).
# VITE_LIVETENNIS_DAILY_BUDGET=90

# Feature flags
# VITE_FEATURE_INJURIES=true        # injury report, badges and filters (off by default)
# VITE_FEATURE_PLAYER_PHOTOS=false  # Wikimedia Commons player photos (on by default)
